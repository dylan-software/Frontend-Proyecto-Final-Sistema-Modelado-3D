# Base URL of the deployed BACKEND (no trailing slash, https in production).
# Local dev:   http://localhost:4000
# Production:  https://your-backend.onrender.com
#
# IMPORTANT: NEXT_PUBLIC_* variables are baked into the JavaScript at BUILD time.
# If you change this value in Vercel you must trigger a new deployment for it to take effect.
NEXT_PUBLIC_API_URL=http://localhost:4000
